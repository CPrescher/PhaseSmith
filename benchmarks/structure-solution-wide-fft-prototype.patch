+"""Wide streaming FFT batches preserve equations, float bits and phase decisions."""
+
+import numpy as np
+import pytest
+from phasesmith import _core
+from phasesmith.experimental.solution_fft_reference import real_density_transform_reference
+
+pytestmark = pytest.mark.skipif(
+    not hasattr(_core, "_solution_real_fft_transform"), reason="experimental-solution"
+)
+
+def transform(values, to_density, wide):
+    return _core._solution_real_fft_transform(
+        np.ascontiguousarray(values.real).ravel(),
+        np.ascontiguousarray(values.imag).ravel(),
+        values.shape,
+        to_density,
+        wide_fft_batches=wide,
+    )
+
+@pytest.mark.parametrize(
+    "shape", [(8, 8, 8), (10, 14, 18), (32, 16, 64), (64, 32, 16), (8, 128, 8), (64, 64, 64)]
+)
+@pytest.mark.parametrize("kind", ["random", "impulse", "constant", "nyquist"])
+@pytest.mark.parametrize("to_density", [False, True])
+def test_wide_outputs_preserve_bits_and_independent_dft(shape, kind, to_density):
+    rng = np.random.default_rng(312)
+    values = rng.normal(size=shape).astype(complex)
+    if to_density:
+        values += 1j * rng.normal(size=shape)
+    if kind == "impulse":
+        values.fill(0)
+        values[-1, 1, -2] = 1 + (2j if to_density else 0)
+    elif kind == "constant":
+        values.fill(1 + (0.3j if to_density else 0))
+    elif kind == "nyquist":
+        values = ((-1.0) ** np.indices(shape).sum(axis=0)).astype(complex)
+    for scale in [1e-150, 1.0, 1e150]:
+        sample = values * scale
+        before = sample.copy()
+        old, new = transform(sample, to_density, False), transform(sample, to_density, True)
+        for key in old:
+            np.testing.assert_array_equal(old[key].view(np.uint64), new[key].view(np.uint64))
+        got = (new["real"] + 1j * new["imaginary"]).reshape(shape)
+        ref = real_density_transform_reference(sample, to_density=to_density)
+        np.testing.assert_allclose(got, ref, rtol=2e-12, atol=8e-12 * scale)
+        np.testing.assert_array_equal(sample, before)
+
+@pytest.mark.parametrize("seed", [0, 42, 1034])
+@pytest.mark.parametrize("rank", [None, 0])
+@pytest.mark.parametrize("omit", [0.0, 0.1])
+def test_complete_phase_history_and_random_omission_are_bitwise_identical(seed, rank, omit):
+    from test_solution_dual_space import inputs
+
+    shape, cell, h, amp, phases, support = inputs()
+    args = (
+        shape,
+        list(cell.as_tuple()),
+        h.ravel(),
+        amp,
+        phases,
+        support.ravel(),
+        80,
+        1.5,
+        64,
+        0.25,
+        3.0,
+        omit,
+        seed,
+        rank,
+    )
+    common = dict(
+        reusable_workspaces=True,
+        filtered_peak_search=True,
+        batched_fft=True,
+        real_fft=True,
+        fused_phase_workspace=True,
+    )
+    old = _core._solution_count_free_dual_space(*args, **common)
+    new = _core._solution_count_free_dual_space(*args, **common, wide_fft_batches=True)
+    for key in ["density", "history"]:
+        np.testing.assert_array_equal(old[key].view(np.uint64), new[key].view(np.uint64))
+    assert old["adaptive_peaks"] == new["adaptive_peaks"]
+    assert old["best_cycle"] == new["best_cycle"]
+    assert old["wide_fft_transforms"] == 0
+    assert new["wide_fft_transforms"] == 2 * len(new["history"])
+    bad = dict(common, real_fft=False)
+    with pytest.raises(ValueError, match="require"):
+        _core._solution_count_free_dual_space(*args, **bad, wide_fft_batches=True)
+
+@pytest.mark.parametrize("invalid", ["nan", "inf", "length", "odd", "small", "large", "complex"])
+def test_original_input_boundaries_still_apply(invalid):
+    real, imaginary, shape = np.ones(512), np.zeros(512), (8, 8, 8)
+    if invalid == "nan":
+        real[0] = np.nan
+    elif invalid == "inf":
+        imaginary[0] = np.inf
+    elif invalid == "length":
+        imaginary = imaginary[:-1]
+    elif invalid == "odd":
+        shape = (8, 7, 8)
+    elif invalid == "small":
+        shape = (8, 6, 8)
+    elif invalid == "large":
+        shape = (8, 130, 8)
+    else:
+        imaginary[0] = 1
+    with pytest.raises(ValueError):
+        _core._solution_real_fft_transform(real, imaginary, shape, False, wide_fft_batches=True)
+
+@pytest.mark.parametrize("symbol", ["P1", "P-1", "Pm"])
+def test_shared_search_keeps_counts_and_exact_final_model(symbol):
+    from phasesmith.experimental.solution import SolutionOptions, solve_structure_elements
+    from test_solution_shared_search import synthetic
+
+    cell, group, data, _, species = synthetic(symbol)
+    common = dict(
+        cell=cell,
+        space_group=group,
+        elements=["Fe", "O"],
+        maximum_atoms=12,
+        symmetry_recycling=True,
+        tangent_refinement=True,
+        wilson_normalization=True,
+        phase_quality_selection=True,
+        phase_origin_selection=True,
+        chemical_assignment=True,
+        iterative_refinement=True,
+        score_only_evaluation=True,
+        reusable_fourier_workspaces=True,
+        work_sliced_phasing=True,
+        isotropic_assignment_refinement=True,
+        filtered_peak_search=True,
+        batched_fft=True,
+        real_fft=True,
+        fused_phase_workspace=True,
+        cached_normal_refinement=True,
+        multiplicity_weighted_refinement=True,
+        ambiguous_assignments=True,
+        cached_assignment_refinement=True,
+        specialized_isotropic_refinement=True,
+        options=SolutionOptions(
+            phasing="dual_space",
+            trials=4,
+            cycles=800,
+            max_seconds=60,
+            r1_target=0.005,
+            completion=False,
+        ),
+    )
+    old = solve_structure_elements(data, **common)
+    new = solve_structure_elements(data, **common, wide_fft_batches=True)
+    assert old.target_met and new.target_met
+    assert (
+        dict(old.composition)
+        == dict(new.composition)
+        == {e: int(np.count_nonzero(species == e)) for e in set(species)}
+    )
+    np.testing.assert_array_equal(
+        old.best.fractional_xyz.view(np.uint64), new.best.fractional_xyz.view(np.uint64)
+    )
+    assert old.best.r1 == new.best.r1
+    assert new.shared_search.wide_fft_transforms == new.shared_search.real_phase_transforms > 0
+    assert old.shared_search.wide_fft_transforms == 0
+    with pytest.raises(TypeError, match="boolean"):
+        solve_structure_elements(data, **common, wide_fft_batches=1)
+    bad = dict(common, real_fft=False)
+    with pytest.raises(ValueError, match="requires"):
+        solve_structure_elements(data, **bad, wide_fft_batches=True)
