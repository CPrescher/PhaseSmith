+// Reuse the left row across up to four products. Each pair retains lane_dot's
+// eight independent accumulators, their final reduction, then the scalar tail.
+fn dot_four(row: &[f64], jacobian: &[f64], width: usize, start: usize, count: usize) -> [f64; 4] {
+    if count != 4 {
+        let mut result = [0.; 4];
+        for (pair, value) in result.iter_mut().enumerate().take(count) {
+            *value = lane_dot(
+                row,
+                &jacobian[(start + pair) * width..(start + pair + 1) * width],
+            );
+        }
+        return result;
+    }
+    let a = &jacobian[start * width..(start + 1) * width];
+    let b = &jacobian[(start + 1) * width..(start + 2) * width];
+    let c = &jacobian[(start + 2) * width..(start + 3) * width];
+    let d = &jacobian[(start + 3) * width..(start + 4) * width];
+    let mut sa = [0.; 8];
+    let mut sb = [0.; 8];
+    let mut sc = [0.; 8];
+    let mut sd = [0.; 8];
+    let mut rows = row.chunks_exact(8);
+    for ((((x, a), b), c), d) in rows
+        .by_ref()
+        .zip(a.chunks_exact(8))
+        .zip(b.chunks_exact(8))
+        .zip(c.chunks_exact(8))
+        .zip(d.chunks_exact(8))
+    {
+        for i in 0..8 {
+            sa[i] += x[i] * a[i];
+            sb[i] += x[i] * b[i];
+            sc[i] += x[i] * c[i];
+            sd[i] += x[i] * d[i];
+        }
+    }
+    let mut result = [
+        sa.into_iter().sum(),
+        sb.into_iter().sum(),
+        sc.into_iter().sum(),
+        sd.into_iter().sum(),
+    ];
+    let full = width / 8 * 8;
+    for (i, &x) in rows.remainder().iter().enumerate() {
+        let j = full + i;
+        result[0] += x * a[j];
+        result[1] += x * b[j];
+        result[2] += x * c[j];
+        result[3] += x * d[j];
+    }
+    result
+}
