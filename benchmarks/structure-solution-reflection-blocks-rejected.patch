diff --git a/crates/phasesmith-solution/src/reflection_blocks.rs b/crates/phasesmith-solution/src/reflection_blocks.rs
new file mode 100644
index 0000000..43be41a
--- /dev/null
+++ b/crates/phasesmith-solution/src/reflection_blocks.rs
@@ -0,0 +1,139 @@
+//! Reflection tiles with unchanged per-reflection image/derivative reductions.
+use super::{
+    AdpMode, GeometryCache, PreparedSymmetricModel, canonical_isotropic, tensor_contraction,
+};
+use crate::math3::dot;
+use phasesmith_crystallography::Matrix3;
+
+pub(super) const LANES: usize = 8;
+pub(super) const SCRATCH_BYTES: usize = 256 * 1024;
+
+pub(super) fn eligible(model: &PreparedSymmetricModel, geometry: Option<&GeometryCache>) -> bool {
+    model.blocked_evaluation
+        && geometry.is_some()
+        && model
+            .parameter_count
+            .checked_mul(model.hkl.len().min(LANES))
+            .and_then(|n| n.checked_mul(2 * size_of::<f64>()))
+            .is_some_and(|bytes| bytes <= SCRATCH_BYTES)
+}
+
+#[allow(clippy::too_many_lines)] // One fused value/derivative pass; tile reduction order is explicit.
+pub(super) fn evaluate(
+    model: &PreparedSymmetricModel,
+    parameters: &[f64],
+    tensors: &[Matrix3],
+    tensor_derivatives: &[Vec<Matrix3>],
+    geometry: &GeometryCache,
+    amplitudes: &mut [f64],
+    jacobian: &mut [f64],
+) {
+    let count = model.hkl.len();
+    let mut dre = vec![0.; model.parameter_count * count.min(LANES)];
+    let mut dim = dre.clone();
+    let isotropic: Vec<_> = model
+        .tensor_bases
+        .iter()
+        .map(|basis| model.mode == AdpMode::Isotropic && canonical_isotropic(basis))
+        .collect();
+    for start in (0..count).step_by(LANES) {
+        let lanes = LANES.min(count - start);
+        dre.fill(0.);
+        dim.fill(0.);
+        let mut real = [0.; LANES];
+        let mut imaginary = [0.; LANES];
+        let mut image_index = 0;
+        for (site_index, site) in model.symmetry.sites.iter().enumerate() {
+            let (coordinate_offset, tensor_offset) = model.offsets[site_index];
+            let mut iso_displacement = [0.; LANES];
+            let mut iso_derivative = [0.; LANES];
+            if isotropic[site_index] {
+                for lane in 0..lanes {
+                    let q = model.reciprocal[start + lane];
+                    let weight = -2. * std::f64::consts::PI.powi(2) * dot(q, q);
+                    iso_displacement[lane] = (weight * tensors[site_index][0][0]).exp();
+                    iso_derivative[lane] = weight * tensor_derivatives[site_index][0][0][0];
+                }
+            }
+            for _ in &site.images {
+                let mut re = [0.; LANES];
+                let mut im = [0.; LANES];
+                let mut coordinate = [[0.; LANES]; 3];
+                let mut tensor = [[0.; LANES]; 6];
+                for lane in 0..lanes {
+                    let h = start + lane;
+                    let g = &geometry.entries[h * model.symmetry.full_count + image_index];
+                    let mut phase = g.phase;
+                    for i in 0..site.coordinate_basis.len() {
+                        phase += g.coordinate_phase[i] * parameters[coordinate_offset + i];
+                        coordinate[i][lane] = g.coordinate_phase[i];
+                    }
+                    let displacement = if isotropic[site_index] {
+                        iso_displacement[lane]
+                    } else {
+                        tensor_contraction(g.tensor_weight, tensors[site_index]).exp()
+                    };
+                    let factor = model.factors[h * model.symmetry.sites.len() + site_index];
+                    let (sin, cos) = phase.sin_cos();
+                    re[lane] = factor * displacement * cos;
+                    im[lane] = factor * displacement * sin;
+                    for (i, &du) in tensor_derivatives[site_index].iter().enumerate() {
+                        tensor[i][lane] = if isotropic[site_index] {
+                            iso_derivative[lane]
+                        } else {
+                            tensor_contraction(g.tensor_weight, du)
+                        };
+                    }
+                }
+                for lane in 0..lanes {
+                    real[lane] += re[lane];
+                    imaginary[lane] += im[lane];
+                }
+                for (i, row) in coordinate
+                    .iter()
+                    .enumerate()
+                    .take(site.coordinate_basis.len())
+                {
+                    let offset = (coordinate_offset + i) * lanes;
+                    for lane in 0..lanes {
+                        dre[offset + lane] -= row[lane] * im[lane];
+                        dim[offset + lane] += row[lane] * re[lane];
+                    }
+                }
+                for (i, row) in tensor
+                    .iter()
+                    .enumerate()
+                    .take(tensor_derivatives[site_index].len())
+                {
+                    let offset = (tensor_offset + i) * lanes;
+                    for lane in 0..lanes {
+                        dre[offset + lane] += row[lane] * re[lane];
+                        dim[offset + lane] += row[lane] * im[lane];
+                    }
+                }
+                image_index += 1;
+            }
+        }
+        let mut raw = [0.; LANES];
+        let mut weights = [1.; LANES];
+        for lane in 0..lanes {
+            raw[lane] = real[lane].hypot(imaginary[lane]);
+            weights[lane] = model
+                .families
+                .as_ref()
+                .map_or(1., |p| p.square_roots[start + lane]);
+            amplitudes[start + lane] = raw[lane] * weights[lane];
+        }
+        for parameter in 0..model.parameter_count {
+            for lane in 0..lanes {
+                if raw[lane] > 1e-14 {
+                    jacobian[parameter * count + start + lane] = ((real[lane]
+                        * dre[parameter * lanes + lane]
+                        + imaginary[lane] * dim[parameter * lanes + lane])
+                        / raw[lane])
+                        * weights[lane];
+                }
+            }
+        }
+    }
+}
