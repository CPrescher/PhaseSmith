+
+/// Fixed-width views remove per-value lane multiplication and bounds checks.
+#[inline]
+pub(super) fn pack_specialized(
+    input: &[Complex<f64>],
+    output: &mut [Complex<f64>],
+    offset: usize,
+    stride: usize,
+    length: usize,
+    lanes: usize,
+) {
+    if lanes != 8 {
+        return pack(input, output, offset, stride, length, lanes);
+    }
+    let mut lines = output.chunks_exact_mut(length);
+    let [a, b, c, d, e, f, g, h]: [&mut [Complex<f64>]; 8] =
+        std::array::from_fn(|_| lines.next().expect("eight packed lines"));
+    for row in 0..length {
+        let start = offset + row * stride;
+        let source = &input[start..start + 8];
+        a[row] = source[0];
+        b[row] = source[1];
+        c[row] = source[2];
+        d[row] = source[3];
+        e[row] = source[4];
+        f[row] = source[5];
+        g[row] = source[6];
+        h[row] = source[7];
+    }
+}
+
+/// Restore fixed-width views in exactly the original row/lane copy order.
+#[inline]
+pub(super) fn unpack_specialized(
+    input: &[Complex<f64>],
+    output: &mut [Complex<f64>],
+    offset: usize,
+    stride: usize,
+    length: usize,
+    lanes: usize,
+) {
+    if lanes != 8 {
+        return unpack(input, output, offset, stride, length, lanes);
+    }
+    let mut lines = input.chunks_exact(length);
+    let [a, b, c, d, e, f, g, h]: [&[Complex<f64>]; 8] =
+        std::array::from_fn(|_| lines.next().expect("eight packed lines"));
+    for row in 0..length {
+        let start = offset + row * stride;
+        let target = &mut output[start..start + 8];
+        target[0] = a[row];
+        target[1] = b[row];
+        target[2] = c[row];
+        target[3] = d[row];
+        target[4] = e[row];
+        target[5] = f[row];
+        target[6] = g[row];
+        target[7] = h[row];
+    }
+}
