index 13b7188..937a6ea 100644
--- a/python/phasesmith/experimental/solution_assignment_reference.py
+++ b/python/phasesmith/experimental/solution_assignment_reference.py
@@ -55,3 +55,111 @@ def assignment_neighbors_reference(columns, factors, observed, labels, maximum=4
