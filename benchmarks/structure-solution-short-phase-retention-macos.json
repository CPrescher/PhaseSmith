  "phase_cycle_qualification": "Existing per-start wall-clock safeguards may produce cycle-count differences; scheduling rules, quotas and caps are unchanged.",
  "retention_verifier_source": "import json,hashlib\nfrom pathlib import Path\nfrom collections import Counter\nimport numpy as np\nprefix='structure-solution-short-phase'\ndef load(p):return json.loads(Path(p).read_text())\ndef sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()\ndef rows(p):return {x['id']:x for x in load(p)['runs'] if x['method']=='phasesmith'}\npaths={m:Path('benchmarks')/f'{prefix}-{m}-macos.json' for m in ['control','cache']}\na,b=(rows(paths[m]) for m in ['control','cache'])\nhistory=Path('benchmarks/structure-solution-normal-reuse-cache-macos.json');old=rows(history)\nassert a.keys()==b.keys()==old.keys() and len(a)==35\nchecks={'structures':lambda r:bool(r['correct']),\n 'total_non_h_counts':lambda r:bool(r['total_non_h_count_correct']),\n 'per_element_counts':lambda r:bool((r.get('reference_audit') or {}).get('counts_match')),\n 'strict_002_angstrom':lambda r:bool((r.get('reference_audit') or {}).get('strict_002_angstrom'))}\nsets={k:{m:sorted(i for i,r in rr.items() if fn(r)) for m,rr in [('previous_best',old),('control',a),('cache',b)]} for k,fn in checks.items()}\nassert len(sets['structures']['previous_best'])==19\nassert sets['structures']['control']==sets['structures']['previous_best']\n\ncase_rows=[]\nfor i in sorted(a):\n counts={m:dict(Counter(r[i]['model']['species'])) if r[i].get('model') else {} for m,r in [('previous_best',old),('control',a),('cache',b)]}\n same=json.dumps(a[i].get('model'),sort_keys=True,allow_nan=False)==json.dumps(b[i].get('model'),sort_keys=True,allow_nan=False)\n case_rows.append({'id':i,'counts':counts,'correct':{m:r[i]['correct'] for m,r in [('previous_best',old),('control',a),('cache',b)]},'wall_seconds':{m:r[i]['wall_seconds_including_startup'] for m,r in [('control',a),('cache',b)]},'models_identical':same})\ncomparison=load(Path('benchmarks')/f'{prefix}-comparison-macos.json')\nwork={m:comparison['runs'][m]['work_totals'] for m in ['control','cache']}\nwall={m:sum(r['wall_seconds_including_startup'] for r in rr.values()) for m,rr in [('control',a),('cache',b)]}\nratios=[a[i]['wall_seconds_including_startup']/b[i]['wall_seconds_including_startup'] for i in a]\nrecord={'schema':'phasesmith.short-phase-retention.v1','development_cases':35,'holdout_outcomes_opened':False,'report_sha256':{m:sha(p) for m,p in paths.items()},'previous_best_sha256':sha(history),'case_sets':sets,'cumulative_wall_seconds':wall,'cumulative_wall_saving_fraction':1-wall['cache']/wall['control'],'median_paired_control_over_cache':float(np.median(ratios)),'faster_cases':sum(r>1 for r in ratios),'slower_cases':sum(r<1 for r in ratios),'identical_model_records_including_no_model':sum(r['models_identical'] for r in case_rows),'model_record_mismatch_cases':[r['id'] for r in case_rows if not r['models_identical']],'changed_count_vectors':[r['id'] for r in case_rows if r['counts']['control']!=r['counts']['cache']],'work_totals':work,'cases':case_rows,'qualification':'Complete development panels only. Exact recovery case sets compared with fresh matched control and previous best. All 35 inferred count vectors recorded, including no-model outcomes. One balanced collection; timings remain host-sensitive.'}\nrecord['lost_cases']={k:sorted(set(v['previous_best'])-set(v['cache'])) for k,v in sets.items()}\nrecord['gained_cases']={k:sorted(set(v['cache'])-set(v['previous_best'])) for k,v in sets.items()}\nrecord['preserves_all_previous_success_and_count_sets']=all(not x for x in record['lost_cases'].values())\nrecord['stage_seconds']={}\nfor m in ['control','cache']:\n stages=Counter()\n for row in comparison['runs'][m]['cases']:stages.update(row['stage_seconds'])\n record['stage_seconds'][m]=dict(stages)\nca={x['id']:x for x in comparison['runs']['control']['cases']};cb={x['id']:x for x in comparison['runs']['cache']['cases']}\nrecord['phase_cycle_variation']=[{'id':i,'control':ca[i]['fourier_workspace_cycles'],'cache':cb[i]['fourier_workspace_cycles']} for i in ca if ca[i]['fourier_workspace_cycles']!=cb[i]['fourier_workspace_cycles']]\nrecord['phase_cycle_qualification']='Existing per-start wall-clock safeguards may produce cycle-count differences; scheduling rules, quotas and caps are unchanged.'\nfor name, group in sets.items():\n    assert group['previous_best'] == group['control'] == group['cache'], name\nassert [len(sets[k]['cache']) for k in checks] == [19,26,19,15]\nassert record['preserves_all_previous_success_and_count_sets']\nrecord['retention_verifier_source']=Path(__file__).read_text()\nPath('benchmarks',f'{prefix}-retention-macos.json').write_text(json.dumps(record,indent=2)+'\\n')\nprint(json.dumps({k:v for k,v in record.items() if k not in ['cases','case_sets','work_totals','retention_verifier_source']},indent=2))\nfor m in ['control','cache']:print(m,comparison['runs'][m]['summary']['phasesmith'],work[m])\n"
}
