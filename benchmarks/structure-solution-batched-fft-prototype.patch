--- /dev/null
+++ b/crates/phasesmith-solution/src/fft_layout.rs
@@ -0,0 +1,23 @@
+//! Pure layout permutation; no floating-point arithmetic on transform values.
+use rustfft::num_complex::Complex;
+
+/// Transpose a row-major matrix in small tiles to keep both access directions local.
+pub(super) fn transpose(
+    input: &[Complex<f64>],
+    output: &mut [Complex<f64>],
+    rows: usize,
+    columns: usize,
+) {
+    const TILE: usize = 16;
+    debug_assert_eq!(input.len(), rows * columns);
+    debug_assert_eq!(output.len(), input.len());
+    for row0 in (0..rows).step_by(TILE) {
+        for col0 in (0..columns).step_by(TILE) {
+            for row in row0..(row0 + TILE).min(rows) {
+                for col in col0..(col0 + TILE).min(columns) {
+                    output[col * rows + row] = input[row * columns + col];
+                }
+            }
+        }
+    }
+}
