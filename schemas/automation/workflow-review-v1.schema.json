{
  "$id": "https://phasesmith.org/schema/workflow-review-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bound_contacts": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "completed": {
      "type": "boolean"
    },
    "findings": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "free_parameter_count": {
      "minimum": 0,
      "type": "integer"
    },
    "jacobian_rank": {
      "type": [
        "integer",
        "null"
      ]
    },
    "metrics": {
      "type": "object"
    },
    "parameter_count": {
      "minimum": 0,
      "type": "integer"
    },
    "parameter_movements": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "proposal_provenance": {
      "oneOf": [
        {
          "additionalProperties": false,
          "allOf": [
            {
              "else": {
                "properties": {
                  "provider": {
                    "type": "null"
                  }
                }
              },
              "if": {
                "properties": {
                  "kind": {
                    "const": "model"
                  }
                }
              },
              "then": {
                "properties": {
                  "provider": {
                    "type": "string"
                  }
                }
              }
            }
          ],
          "properties": {
            "advisor_packet_id": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "client": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "enum": [
                "human",
                "model",
                "software"
              ]
            },
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "prompt_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "request_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "name",
            "provider",
            "version",
            "client",
            "advisor_packet_id",
            "prompt_sha256",
            "request_id"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "residual": {
      "type": [
        "object",
        "null"
      ]
    },
    "review_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "phasesmith.workflow-review.v1"
    },
    "sources": {
      "type": "object"
    },
    "stages": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "const": "review_required"
    },
    "termination": {
      "type": "string"
    },
    "unresolved_correlations": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "workflow_id": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "review_id",
    "plan_id",
    "workflow_id",
    "status",
    "completed",
    "termination",
    "proposal_provenance",
    "metrics",
    "stages",
    "parameter_movements",
    "bound_contacts",
    "jacobian_rank",
    "parameter_count",
    "free_parameter_count",
    "unresolved_correlations",
    "residual",
    "findings",
    "sources"
  ],
  "title": "phasesmith.workflow-review.v1",
  "type": "object"
}
