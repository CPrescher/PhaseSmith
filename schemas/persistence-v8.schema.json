{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phasesmith:persistence:v7",
  "title": "PhaseSmith persistence manifest version 8",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "archive", "arrays", "bundle"],
  "properties": {
    "format_version": {"const": 8},
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {"const": "arrays.npz"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "arrays": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/array"}
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern", "instrument", "experiment", "fcj_geometry",
        "wavelength_components", "phases", "rietveld_phases",
        "rietveld_domains", "rietveld_selection", "rietveld_options",
        "rietveld_checkpoint", "rietveld_background", "calculation_options",
        "calculation_result", "parameters", "lebail_options",
        "lebail_checkpoint", "lebail_result", "constraints", "metadata"
      ],
      "properties": {
        "pattern": {"type": ["object", "null"]},
        "instrument": {"type": ["object", "null"]},
        "experiment": {"type": ["object", "null"]},
        "fcj_geometry": {"type": ["object", "null"]},
        "wavelength_components": {"type": ["object", "null"]},
        "phases": {"type": "array", "items": {"type": "object"}},
        "rietveld_phases": {"type": "array", "items": {"type": "object"}},
        "rietveld_domains": {"type": "array", "items": {"type": ["object", "null"]}},
        "rietveld_selection": {"type": ["object", "null"]},
        "rietveld_options": {"type": ["object", "null"]},
        "rietveld_checkpoint": {"type": ["object", "null"]},
        "rietveld_background": {"type": ["object", "null"]},
        "calculation_options": {"type": ["object", "null"]},
        "calculation_result": {"type": ["object", "null"]},
        "parameters": {"type": ["object", "null"]},
        "lebail_options": {"type": ["object", "null"]},
        "lebail_checkpoint": {"type": ["object", "null"]},
        "lebail_result": {"type": ["object", "null"]},
        "constraints": {"type": "array", "items": {"type": "object"}},
        "metadata": {"type": ["object", "null"]}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "array": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "sha256"],
      "properties": {
        "dtype": {"type": "string", "minLength": 1},
        "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
