{
  "schema_version": 1,
  "scope": "CW Pawley real-data smoke and repeatability gates; not cross-program optimizer parity",
  "datasets": {
    "aps-sucrose-11bmb": {
      "range_deg": [
        1.0,
        24.0
      ],
      "maximum_rwp": 0.25,
      "minimum_profile_correlation": 0.95,
      "max_iterations": 40,
      "background_width_deg": 0.1
    },
    "ansto-echidna-lab6-cw-neutron": {
      "range_deg": [
        20.0,
        125.5
      ],
      "maximum_rwp": 0.3,
      "minimum_profile_correlation": 0.9,
      "max_iterations": 40,
      "background_window_samples": 20
    }
  },
  "common": {
    "nonnegative_areas": true,
    "minimum_relative_chi_square_improvement": 0.05,
    "rwp_recomputation_absolute_tolerance": 1e-12,
    "repeatability": "exact accepted history and calculated array",
    "accepted_terminations": [
      "converged"
    ],
    "weights": "supplied one-sigma uncertainties",
    "profile_parameters": [
      "u_deg2",
      "v_deg2",
      "w_deg2",
      "x_deg",
      "y_deg"
    ],
    "cell_and_wavelength": "fixed",
    "background": "fixed Smooth Bruckner baseline plus one fitted Chebyshev constant"
  }
}
